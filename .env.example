# Optional environment overrides. Never put an API key in YAML.
STACKEXCHANGE_SITE=stackoverflow
STACKEXCHANGE_USER_AGENT=stackoverflow-vitality-observatory/0.2
# STACKEXCHANGE_TAG=python
# STACKEXCHANGE_OUTPUT=data/bronze
# Respostas. A chave acima também serve à coleta de respostas e continua fora do YAML.
# STACKEXCHANGE_ANSWERS_SITE=stackoverflow
# STACKEXCHANGE_ANSWERS_ENDPOINT=https://api.stackexchange.com/2.3/questions
# STACKEXCHANGE_ANSWERS_USER_AGENT=stackoverflow-vitality-observatory/0.2
# STACKEXCHANGE_ANSWERS_BRONZE=data/bronze
# STACKEXCHANGE_ANSWERS_SILVER=data/silver
# Optional; absent by default and excluded from serialization/logs.
STACKEXCHANGE_API_KEY=
